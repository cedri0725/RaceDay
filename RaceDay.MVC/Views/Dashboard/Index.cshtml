@model IEnumerable<RaceDay.MVC.Models.EventViewModel>

@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Organiser Dashboard</h2>
        <!-- We will make this button work in the next step -->
        <a href="#" class="btn btn-success">+ Create New Event</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <h5 class="card-title">My Events</h5>
            <table class="table table-hover mt-3">
                <thead class="table-light">
                    <tr>
                        <th>Event Name</th>
                        <th>Date</th>
                        <th>Location</th>
                        <th>Capacity</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted">You haven't created any events yet.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var ev in Model)
                        {
                            <tr>
                                <td>@ev.Event_Name</td>
                                <td>@ev.Event_Date.ToString("dd MMM yyyy")</td>
                                <td>@ev.Location</td>
                                <td>@ev.Max_Capacity</td>
                                <td>
                                    <button class="btn btn-sm btn-outline-primary">Edit</button>
                                    <button class="btn btn-sm btn-outline-info">View Enrolments</button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>